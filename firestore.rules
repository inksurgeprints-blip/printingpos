rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single shared shop dataset. Only signed-in staff accounts (created by you
    // in the Firebase console - there's no public sign-up) can read or write.
    match /artifacts/{appId}/shop/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
